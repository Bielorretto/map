# Copier ce fichier en .env puis renseigner UNE clé.
# OpenAI (prioritaire si présente) : modèle par défaut gpt-6-astra, effort de raisonnement high.
OPENAI_API_KEY=
# ou Claude (Anthropic) : modèle par défaut claude-opus-5-5.
ANTHROPIC_API_KEY=
# Optionnel :
# ASSISTANT_FOURNISSEUR=openai        # ou anthropic
# ASSISTANT_MODELE=gpt-6-astra        # ex. gpt-6.1-sol (5x moins cher, presque aussi fort)
# ASSISTANT_EFFORT=high               # low | medium | high | xhigh
